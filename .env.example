# ==============================================================================
# NEWS TRADING — MTT | Environment Configuration
# ==============================================================================

# Application
APP_NAME="NEWS TRADING — MTT"
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=true
CORS_ORIGINS=*

# Security (Override SECRET_KEY in production!)
SECRET_KEY=mtt-super-secret-jwt-key-change-in-production-2026-quantrelic
ACCESS_TOKEN_EXPIRE_MINUTES=480

# PostgreSQL (Authoritative Financial Ledger Store)
DATABASE_URL=postgresql+asyncpg://mtt_user:mtt_password@postgres:5432/mtt_exchange
SYNC_DATABASE_URL=postgresql+psycopg://mtt_user:mtt_password@postgres:5432/mtt_exchange
USE_EMBEDDED_POSTGRES=false
EMBEDDED_POSTGRES_DIR=/home/user/.cache/mtt_pgdata

# Redis (Real-Time Event Fanout, Conflation & Rate Limiting)
REDIS_URL=redis://redis:6379/0
USE_FAKE_REDIS_FALLBACK=true

# Default Tournament Parameters (Configurable per game in Admin UI)
DEFAULT_TRADING_DURATION_SEC=2700
DEFAULT_SETTLEMENT_DURATION_SEC=300
DEFAULT_INITIAL_CASH=500000.0000
DEFAULT_OPENING_PRICE=1000.0000
DEFAULT_SHARES_PER_STOCK=100
DEFAULT_INITIAL_MARGIN_RATIO=0.5000
DEFAULT_MAINTENANCE_MARGIN_RATIO=0.2500
DEFAULT_CRITICAL_MARGIN_RATIO=0.1250
DEFAULT_MARGIN_CALL_GRACE_SEC=60
DEFAULT_SHORT_POOL_PER_PLAYER=50
DEFAULT_MIN_SHORT_POOL_SHARES=15000
DEFAULT_SHORT_LIMIT_PER_STOCK=500
DEFAULT_TICK_SIZE=0.0500
DEFAULT_MARKET_COLLAR_PCT=0.1000

# Broadcast Conflation Intervals
WS_MARKET_TICK_MS=150
WS_LEADERBOARD_TICK_MS=2000

# Frontend Port & Internal Proxy Target
FRONTEND_PORT=3006
PORT=3006
BACKEND_INTERNAL_URL=http://backend:8000
